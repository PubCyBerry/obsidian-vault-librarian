# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Exclude the vitest cache and session files written by a dev vault
tests/.out
sessions/
snapshots/

# The demo vault's app state, apart from the settings the README recordings rely on, and what
# docs/demo/record.mjs writes before it makes the media.
docs/demo/Work/.obsidian/*
!docs/demo/Work/.obsidian/app.json
!docs/demo/Work/.obsidian/appearance.json
!docs/demo/Work/.obsidian/community-plugins.json
!docs/demo/Work/.obsidian/core-plugins.json
docs/demo/Work/.trash/
docs/demo/out/
