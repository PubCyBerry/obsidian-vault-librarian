{
	"name": "vault-librarian",
	"version": "2.4.1",
	"description": "A Pi-style vault agent for Obsidian that finds, reads, creates and edits your notes with tool calling, on desktop and mobile.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "biome check && eslint .",
		"format": "biome check --write",
		"test": "vitest --run"
	},
	"keywords": [
		"obsidian",
		"agent",
		"llm",
		"openai-compatible"
	],
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^30.1.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.86.1",
		"@earendil-works/pi-ai": "0.86.1",
		"@modelcontextprotocol/sdk": "1.30.0",
		"just-bash": "3.4.2",
		"typebox": "1.3.27",
		"zod": "3.25.76"
	}
}
