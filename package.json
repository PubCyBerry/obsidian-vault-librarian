{
	"name": "vault-librarian",
	"version": "2.23.2",
	"description": "A Pi-style vault agent for Obsidian that finds, reads, creates and edits your notes with tool calling, on desktop and mobile.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "biome check && eslint .",
		"format": "biome check --write",
		"test": "vitest --run",
		"test:mutation": "stryker run"
	},
	"keywords": [
		"obsidian",
		"agent",
		"llm",
		"openai-compatible"
	],
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@eslint/js": "^9.39.5",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"fast-check": "^4.11.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"jsdom": "^31.0.1",
		"obsidian": "^1.14.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@modelcontextprotocol/sdk": "1.32.2",
		"just-bash": "3.6.1",
		"thinking-orbs": "0.3.2",
		"typebox": "1.4.7",
		"zod": "4.6.7"
	}
}
