{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// main.js is the bundle and package-lock.json is written by npm. Obsidian writes the demo
		// vault's settings in its own format.
		"includes": ["**", "!main.js", "!package-lock.json", "!docs/demo/Work"]
	},
	"formatter": {
		// Indentation and line endings follow .editorconfig.
		"useEditorconfig": true,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"rules": {
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	}
}
